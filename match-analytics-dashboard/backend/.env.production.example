# Configuration de PRODUCTION (serveur public). Copiez ce fichier en ".env" sur le serveur
# puis complétez les valeurs. Ne le partagez jamais.

NODE_ENV=production
PORT=4000
# L'API n'écoute que sur le serveur lui-même : seul Caddy (HTTPS) est visible depuis Internet.
HOST=127.0.0.1
TRUST_PROXY=1

# Adresse publique du site, en HTTPS, sans « / » final.
CORS_ORIGIN=https://mymatch.netlify.app 

# Mot de passe de l'utilisateur PostgreSQL « matchapp » (voir le guide). Surtout pas « postgres ».
DATABASE_URL=postgresql://neondb_owner:npg_4vdwEILTczD3@ep-cold-fog-b5eo03j8-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require


# Au moins 32 caractères aléatoires : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=8h

# Compte administrateur créé par « npm run db:seed ». Mot de passe long et unique.
# Supprimez SEED_PASSWORD de ce fichier une fois le seed terminé.
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=Administrateur
# Pas de match fictif sur le serveur public.
SEED_DEMO=false

# Les vidéos sont stockées hors du dossier de l'application (mises à jour sans risque).
VIDEO_STORAGE_DIR=/var/lib/match-analytics/videos
MAX_VIDEO_BYTES=2147483648

# Clips : durée maximale d'un clip (secondes) et délai maximal de découpe (minutes). FFmpeg doit être installé.
MAX_CLIP_SECONDS=300
CLIP_RENDER_TIMEOUT_MINUTES=15
