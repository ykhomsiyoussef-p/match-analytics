# Copiez ce fichier en ".env" puis complétez les valeurs vides.
# Ne partagez JAMAIS le fichier .env (il est ignoré par git).

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Si vous utilisez docker-compose.yml, cette valeur fonctionne telle quelle.
DATABASE_URL=postgresql://match:match_dev_password@localhost:5432/match_analytics

# Secret de signature des sessions : au moins 32 caractères aléatoires.
# Générez-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Compte créé par "npm run db:seed" (rôle administrateur).
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=Administrateur

# Optionnel : stockage des vidéos (valeurs par défaut ci-dessous).
# VIDEO_STORAGE_DIR=./storage/videos
# MAX_VIDEO_BYTES=2147483648
# Optionnel : découpe des clips (FFmpeg doit être installé).
# FFMPEG_PATH=ffmpeg
# MAX_CLIP_SECONDS=300
# CLIP_RENDER_TIMEOUT_MINUTES=15
