# Remplacez VOTRE-DOMAINE.COM par votre nom de domaine (le DNS doit déjà pointer vers le serveur).
# Caddy obtient et renouvelle automatiquement le certificat HTTPS.
VOTRE-DOMAINE.COM {
	# Requêtes de l'API et lecture des vidéos : transmises au backend (Range, envoi par morceaux inclus).
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	# Tout le reste : le site (application React compilée).
	handle {
		root * /var/www/match-analytics
		encode zstd gzip

		# Fichiers à nom unique (hash) : mis en cache longtemps. Le reste est revérifié à chaque visite.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		# Les routes de l'application (/matchs, /video...) renvoient index.html.
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Le navigateur n'exécute que les scripts de ce site (protection contre l'injection de code).
		# Si la page reste blanche après une mise à jour, ouvrez la console du navigateur (F12) : les erreurs « CSP » s'y affichent.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
